# Copie para .env.local (local) ou cadastre em Vercel > Project > Settings > Environment Variables

# Endereço final do site, sem barra no fim (usado no SEO, sitemap e robots)
NEXT_PUBLIC_SITE_URL=https://www.seudominio.com.br

# Links do checkout (Cakto, Kiwify, Hotmart, Eduzz, Shopify...).
# Todos os botões levam para /comprar, que escolhe o link certo:
#   - até NEXT_PUBLIC_FIM_OFERTA  -> CHECKOUT_URL_PROMO (oferta de Black Friday)
#   - depois                      -> CHECKOUT_URL (preço normal)
CHECKOUT_URL_PROMO=https://pay.cakto.com.br/LINK-DA-OFERTA
CHECKOUT_URL=https://pay.cakto.com.br/LINK-NORMAL

# Preços exibidos (somente números)
# PRECO_DE = preço normal (aparece riscado na oferta e vira o preço após o prazo)
# PRECO_POR = preço promocional (vale até o fim da oferta)
NEXT_PUBLIC_PRECO_DE=67
NEXT_PUBLIC_PRECO_POR=47

# Fim da oferta, horário de Brasília (-03:00). Depois disso o site troca sozinho
# para o link e o preço normais, sem precisar de novo deploy.
NEXT_PUBLIC_FIM_OFERTA=2026-11-30T23:59:59-03:00

# Dados do rodapé e da política de privacidade
NEXT_PUBLIC_EMPRESA=Seu Nome ou Razão Social
NEXT_PUBLIC_CNPJ=00.000.000/0001-00
NEXT_PUBLIC_EMAIL_SUPORTE=suporte@seudominio.com.br
NEXT_PUBLIC_PLATAFORMA_PAGAMENTO=Kiwify

# Opcionais: medição (só ativa após o visitante aceitar os cookies)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Opcional: verificação do Google Search Console pela meta tag
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
